# Template for secrets (DB URL, API keys) — never commit real .env

DATABASE_URL=
GEMINI_API_KEY=

# Postmark: used both for the inbound-enquiry webhook (POST /enquiries/from-email)
# and for sending the approved quotation PDF (POST /quotations/{id}/approve-and-send)
POSTMARK_API_KEY=
POSTMARK_FROM_EMAIL=

# Dashboard (Phase C): where dashboard/app.py sends its API requests. Points at
# a local `uvicorn api.main:app` during development; repoint at the hosted API
# URL once Phase D deploys it.
API_BASE_URL=http://127.0.0.1:8010

# Dashboard (Phase C): single shared password gating the whole Streamlit app
# (see dashboard/lib/auth.py -- this is a 1-3 person internal tool, not
# per-user auth).
DASHBOARD_PASSWORD=

# Dashboard (Phase C): secret used to sign the persistent login cookie so a
# page refresh doesn't log the user out (see dashboard/lib/auth.py). Any long
# random string works -- e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
DASHBOARD_SECRET_KEY=
